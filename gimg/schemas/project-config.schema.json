{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project configuration",
  "description": "Per-project configuration file (galivelop-images.json) read by the image generator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "minVersion",
    "name",
    "delivery",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema reference so editors can validate and complete the file."
    },
    "minVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Minimum generator version (semver) this project requires."
    },
    "name": {
      "$ref": "#/$defs/name",
      "description": "Project name: lowercase letters, digits and hyphens."
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dir"
      ],
      "description": "Where finished images are delivered inside the project repository.",
      "properties": {
        "dir": {
          "$ref": "#/$defs/relativePath",
          "description": "Delivery directory, relative to the project root."
        },
        "template": {
          "type": "string",
          "default": "{key}-{profile}.png",
          "pattern": "^(?![/~])(?!.*(^|/)\\.\\.(/|$))(?=.*\\{key\\})(?=.*\\{profile\\})(?:[A-Za-z0-9._/-]|\\{key\\}|\\{profile\\})+\\.png$",
          "description": "File name template for delivered images; must contain {key} and {profile}, use only letters, digits, . _ - and /, stay relative without .. segments, and end in .png."
        }
      }
    },
    "manifest": {
      "$ref": "#/$defs/relativePath",
      "default": "galivelop-images.manifest.json",
      "description": "Manifest file path, relative to the project root."
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/profileName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      },
      "description": "Image profiles by name (size, sampling settings, model, style)."
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Lowercase letters, digits and hyphens."
    },
    "profileName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$",
      "description": "Profile name: lowercase letters and digits, starting with a letter, no hyphens (the profile is what follows the last hyphen in delivered file names)."
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/~])(?!.*(^|/)\\.\\.(/|$))[^\\\\\\u0000-\\u001f\\u007f]+$",
      "description": "Relative path that cannot be absolute, start with ~, contain .. segments, backslashes or control characters."
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "description": "Sampling steps."
    },
    "cfg": {
      "type": "number",
      "minimum": 0,
      "maximum": 30,
      "description": "Classifier-free guidance scale."
    },
    "sampler": {
      "type": "string",
      "minLength": 1,
      "description": "Sampler name."
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "description": "One image profile.",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096,
          "description": "Image width in pixels."
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096,
          "description": "Image height in pixels."
        },
        "steps": {
          "$ref": "#/$defs/steps"
        },
        "cfg": {
          "$ref": "#/$defs/cfg"
        },
        "sampler": {
          "$ref": "#/$defs/sampler"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Model identifier."
        },
        "style": {
          "type": "string",
          "description": "Fixed text appended to every prompt of this profile."
        },
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "description": "How a draft of this profile differs (D32). Without it a draft is half the sides, 8 steps, same model.",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "description": "Model identifier for drafts."
            },
            "steps": {
              "$ref": "#/$defs/steps"
            },
            "scale": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1,
              "description": "Factor on width and height; each side is rounded to a multiple of 64 (minimum 64)."
            }
          }
        }
      }
    }
  }
}
