{
  "$schema": "../../gimg/schemas/project-config.schema.json",
  "minVersion": "0.1.0",
  "name": "tarkor",
  "brand": {
    "palette": [
      "#8a9aa8",
      "#221c16",
      "#332415",
      "#E0703A",
      "#f1e4d0"
    ]
  },
  "delivery": {
    "dir": "entrega",
    "template": "{key}-{profile}.png"
  },
  "profiles": {
    "og": {
      "width": 1280,
      "height": 640,
      "steps": 6,
      "cfg": 1.0,
      "sampler": "euler",
      "model": "flux2-klein-4b-q8",
      "targetWidth": 1200,
      "targetHeight": 630,
      "draft": {
        "scale": 0.5,
        "steps": 4
      },
      "compose": {
        "template": "plantillas/og.svg",
        "fields": [
          "title1",
          "title2",
          "subtitle",
          "subtitle2"
        ],
        "logo": "logos/tarkor-a-lockup.svg",
        "fonts": [
          "Cinzel",
          "Inter"
        ],
        "fit": "cover"
      }
    },
    "social": {
      "width": 1280,
      "height": 640,
      "steps": 6,
      "cfg": 1.0,
      "sampler": "euler",
      "model": "flux2-klein-4b-q8"
    },
    "banner": {
      "width": 1280,
      "height": 512,
      "steps": 6,
      "cfg": 1.0,
      "sampler": "euler",
      "model": "flux2-klein-4b-q8"
    },
    "square": {
      "width": 1024,
      "height": 1024,
      "steps": 6,
      "cfg": 1.0,
      "sampler": "euler",
      "model": "flux2-klein-4b-q8"
    },
    "header": {
      "width": 1536,
      "height": 512,
      "steps": 6,
      "cfg": 1.0,
      "sampler": "euler",
      "model": "flux2-klein-4b-q8"
    }
  }
}
