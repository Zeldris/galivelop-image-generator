{
  "$schema": "gw/schema/gw.schema.json",
  "version": "0.7.0",
  "schemaVersion": 1,
  "language": "es",
  "visibleLanguages": [
    "es",
    "en"
  ],
  "logRows": false,
  "protectedBranch": "main",
  "pushToProtected": "pr",
  "install": [],
  "ciInstall": [
    "sudo apt-get update -qq && sudo apt-get install -y -qq ffmpeg librsvg2-bin"
  ],
  "setup": [],
  "check": [
    "for f in .githooks/pre-commit .githooks/pre-push .githooks/commit-msg; do bash -n \"$f\"; done",
    "python3 -m unittest discover -s tests -t .",
    "python3 .claude/gw/scripts/ci-local.py --validate"
  ],
  "checkWrapper": "",
  "worktreeLinks": [
    "node_modules",
    ".venv"
  ],
  "worktreeDir": "",
  "requireRetro": false,
  "content": [
    "^docs/",
    "^(README|GLOSSARY|REVIEW|CLAUDE|AGENTS|CHANGELOG|CREDITS)(\\.[a-z]{2})?\\.md$",
    "^\\.claude/skills/.*\\.md$"
  ],
  "roadmap": false,
  "selector": {
    "cases": []
  },
  "logSections": [],
  "designReferences": [],
  "protectedPaths": [],
  "staleRefs": [],
  "linkRoots": [],
  "scoutDir": ".claude/gw/scout",
  "relatedTests": {
    "fast": [
      "python3 .claude/gw/scripts/tests-for.py --run {files}"
    ],
    "slow": []
  },
  "plan": [],
  "taskId": "[A-Z]{2,5}-\\d+",
  "agentSignatures": false,
  "privateCheck": {
    "allowEmails": [
      "128x128@2x.png"
    ]
  },
  "authorDeny": [
    "noreply@anthropic.com"
  ],
  "testMap": {
    "rules": [
      {
        "paths": "^gimg/(?P<m>\\w+)\\.py$",
        "tests": [
          "tests/test_{m}.py"
        ]
      },
      {
        "paths": "^gimg/server\\.py$",
        "tests": [
          "tests/test_server_read.py",
          "tests/test_server_write.py",
          "tests/test_server_brand.py",
          "tests/test_server_templates.py"
        ]
      },
      {
        "paths": "^gimg/locales/",
        "tests": [
          "tests/test_i18n.py"
        ]
      },
      {
        "paths": "^gimg/ui/",
        "tests": [
          "tests/test_ui.py",
          "tests/test_ui_browser.py"
        ]
      },
      {
        "paths": "^tests/(?P<t>test_\\w+\\.py)$",
        "tests": [
          "tests/{t}"
        ]
      },
      {
        "paths": "^\\.claude/hooks/",
        "tests": [
          "tests/test_hooks_sesion.py",
          "tests/test_hooks_autor.py"
        ]
      }
    ],
    "command": "python3 -m unittest {files}"
  },
  "checkLockWait": 300
}
