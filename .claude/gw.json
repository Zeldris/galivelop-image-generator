{
  "$schema": "gw/schema/gw.schema.json",
  "version": "0.5.0",
  "schemaVersion": 1,
  "language": "es",
  "visibleLanguages": [
    "es",
    "en"
  ],
  "logRows": false,
  "protectedBranch": "main",
  "pushToProtected": "pr",
  "install": [],
  "ciInstall": [
    "sudo apt-get update -qq && sudo apt-get install -y -qq ffmpeg librsvg2-bin"
  ],
  "setup": [],
  "check": [
    "for f in .githooks/pre-commit .githooks/pre-push .githooks/commit-msg; do bash -n \"$f\"; done",
    "python3 -m unittest discover -s tests -t ."
  ],
  "checkWrapper": "",
  "worktreeLinks": [
    "node_modules",
    ".venv"
  ],
  "worktreeDir": "",
  "requireRetro": false,
  "content": [
    "^docs/",
    "^(README|GLOSSARY|REVIEW|CLAUDE|AGENTS|CHANGELOG|CREDITS)(\\.[a-z]{2})?\\.md$",
    "^\\.claude/skills/.*\\.md$"
  ],
  "roadmap": false,
  "selector": {
    "cases": []
  },
  "logSections": [],
  "designReferences": [],
  "protectedPaths": [],
  "staleRefs": [],
  "linkRoots": [],
  "scoutDir": ".claude/gw/scout",
  "relatedTests": {
    "fast": [],
    "slow": []
  },
  "plan": [],
  "taskId": "[A-Z]{2,5}-\\d+",
  "agentSignatures": false,
  "privateCheck": {
    "allowEmails": ["128x128@2x.png"]
  }
}
